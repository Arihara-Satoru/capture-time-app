<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F5F7F4" android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="设置" android:textColor="#123C35" android:textSize="28sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="候选时间误差" android:textColor="#123C35" android:textSize="19sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="只有早于当前拍摄时间且超过以下误差的照片才会进入候选。保存后返回主页会自动重新扫描。" android:textColor="#52635D" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="horizontal">
        <EditText android:id="@+id/settingDays" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="0" android:inputType="number" android:maxLines="1" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="12dp" android:text="天" android:textColor="#123C35" />
        <EditText android:id="@+id/settingHours" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="0" android:inputType="number" android:maxLines="1" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="12dp" android:text="时" android:textColor="#123C35" />
        <EditText android:id="@+id/settingMinutes" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="0" android:inputType="number" android:maxLines="1" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="12dp" android:text="分" android:textColor="#123C35" />
        <EditText android:id="@+id/settingSeconds" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="0" android:inputType="number" android:maxLines="1" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="12dp" android:text="秒" android:textColor="#123C35" />
    </LinearLayout>
    <Button android:id="@+id/saveSettings" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="保存并重新扫描" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="24dp" android:background="#D5E2DC" />
    <Button android:id="@+id/viewLogs" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="查看会话日志" />
    <Button android:id="@+id/clearBackups" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="清除备份" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="仅清除本应用创建的 capture-time-app-* 会话目录及其中的备份、日志，不会触碰 .temp 下的其他内容。清除前请确认不再需要恢复照片。" android:textColor="#9A3412" />
</LinearLayout>
