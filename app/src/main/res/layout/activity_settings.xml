<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F5F7F4">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="设置" android:textColor="#123C35" android:textSize="28sp" android:textStyle="bold" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="修改为什么时间" android:textColor="#123C35" android:textSize="19sp" android:textStyle="bold" />
        <Spinner android:id="@+id/timeSelection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="依据哪些字段" android:textColor="#123C35" android:textSize="19sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="每张照片会从勾选且存在有效值的字段中，选出上面的最早或最晚时间。" android:textColor="#52635D" />
        <CheckBox android:id="@+id/sourceCurrentCapture" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="当前拍摄时间（优先 EXIF 原始，缺失时用 MediaStore）" />
        <CheckBox android:id="@+id/sourceExifOriginal" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="EXIF DateTimeOriginal（原始时间）" />
        <CheckBox android:id="@+id/sourceExifDigitized" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="EXIF DateTimeDigitized（数字化时间）" />
        <CheckBox android:id="@+id/sourceExifModified" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="EXIF DateTime（修改时间）" />
        <CheckBox android:id="@+id/sourceMediaTaken" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MediaStore DATE_TAKEN（拍摄时间）" />
        <CheckBox android:id="@+id/sourceMediaAdded" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MediaStore DATE_ADDED（添加时间）" />
        <CheckBox android:id="@+id/sourceFilename" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="文件名中的时间" />
        <CheckBox android:id="@+id/sourceFileModified" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="文件修改时间" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="修改哪些字段" android:textColor="#123C35" android:textSize="19sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="MediaStore 字段由 Android 管理，只读取和核验，不直接写入。" android:textColor="#52635D" />
        <CheckBox android:id="@+id/destinationExifOriginal" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="EXIF DateTimeOriginal（原始时间）" />
        <CheckBox android:id="@+id/destinationExifDigitized" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="EXIF DateTimeDigitized（数字化时间）" />
        <CheckBox android:id="@+id/destinationExifModified" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="EXIF DateTime（修改时间）" />
        <CheckBox android:id="@+id/destinationFileModified" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="文件修改时间" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="忽略误差" android:textColor="#123C35" android:textSize="19sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="目标与已存在字段的差值不超过此误差时，不修改该字段。缺失字段仍会补写。" android:textColor="#52635D" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
            <EditText android:id="@+id/settingDays" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="0" android:inputType="number" android:maxLines="1" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="8dp" android:text="天" />
            <EditText android:id="@+id/settingHours" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="0" android:inputType="number" android:maxLines="1" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="8dp" android:text="时" />
            <EditText android:id="@+id/settingMinutes" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="0" android:inputType="number" android:maxLines="1" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="8dp" android:text="分" />
            <EditText android:id="@+id/settingSeconds" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="0" android:inputType="number" android:maxLines="1" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="8dp" android:text="秒" />
        </LinearLayout>
        <Button android:id="@+id/saveSettings" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="保存并重新扫描" />
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="24dp" android:background="#D5E2DC" />
        <Button android:id="@+id/viewLogs" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="查看会话日志" />
        <Button android:id="@+id/clearBackups" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="清除备份" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="20dp" android:text="仅清除本应用创建的 capture-time-app-* 会话目录及其中的备份、日志，不会触碰 .temp 下的其他内容。清除前请确认不再需要恢复照片。" android:textColor="#9A3412" />
    </LinearLayout>
</ScrollView>
